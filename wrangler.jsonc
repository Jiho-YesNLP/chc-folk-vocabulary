{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker (no server code): serves the static cluster-explorer
  // webapp at the root. `npx wrangler deploy` reads this file.
  "name": "chc-folk-vocab",
  "compatibility_date": "2026-06-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "webapp"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
